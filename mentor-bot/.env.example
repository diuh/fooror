TELEGRAM_BOT_TOKEN=your_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_key_here
ALLOWED_CHAT_ID=your_telegram_numeric_id
DATABASE_PATH=data/mentor.db

# Google Calendar (optional — enables meeting scheduling via text).
# Run `python gcal_auth.py` locally once to obtain these (see that script).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to write events to. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# Voice transcription (free Groq Whisper API). Get key at console.groq.com.
GROQ_API_KEY=
